# Configuração da API do Google Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# Caminho para as credenciais do Firebase Admin
FIREBASE_CREDENTIALS_PATH=firebase-admin-key.json

# Modo de Desenvolvimento (permite testar localmente sem Firebase Auth real)
DEV_MODE=true

# Porta do Servidor FastAPI
PORT=8000

# Modelo do Google Gemini (ex: gemini-3.5-flash, gemini-3.6-flash)
GEMINI_MODEL=gemini-3.5-flash
